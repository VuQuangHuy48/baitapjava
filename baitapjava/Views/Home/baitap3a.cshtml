<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title> baitap3a </title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            line-height: 1.6;
        }

        section {
            border: 1px solid #ccc;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        h2 {
            margin-top: 0;
            color: #2c3e50;
        }

        .box-div {
            width: 100%;
            height: 30px;
            margin: 3px 0;
            border: 1px solid #ddd;
            line-height: 30px;
            text-indent: 10px;
        }

        .game-container {
            position: relative;
            width: 400px;
            height: 300px;
            background: url('https://picsum.photos/id/1062/400/300') no-repeat center/cover;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
        }

        .game-box {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            user-select: none;
        }

        .gb1 {
            background-color: #f1c40f;
        }

        .gb2 {
            background-color: #2ecc71;
        }

        .gb3 {
            background-color: #e74c3c;
        }

        .gb4 {
            background-color: #3498db;
        }

        .hidden {
            visibility: hidden;
        }
    </style>
</head>
<body>

    <h1>BÀI THỰC HÀNH TUẦN 06 - JAVASCRIPT CƠ BẢN</h1>

    <!-- BÀI 1: In các số từ 1 đến N -->
    <section>
        <h2>Bài 1: In các số từ 1 đến N</h2>
        <input type="number" id="numInput" placeholder="Nhập số N">
        <button onclick="printNumbers()">In số</button>
        <p id="res1"></p>
    </section>

    <!-- BÀI 2: Đổi màu 10 thẻ Div -->
    <section>
        <h2>Bài 2: Đổi màu 10 thẻ Div (Chẵn đỏ, Lẻ xanh)</h2>
        <button onclick="changeDivColors()">Đổi màu thẻ Div</button><br><br>
        <div class="box-div">Thẻ Div 1</div>
        <div class="box-div">Thẻ Div 2</div>
        <div class="box-div">Thẻ Div 3</div>
        <div class="box-div">Thẻ Div 4</div>
        <div class="box-div">Thẻ Div 5</div>
        <div class="box-div">Thẻ Div 6</div>
        <div class="box-div">Thẻ Div 7</div>
        <div class="box-div">Thẻ Div 8</div>
        <div class="box-div">Thẻ Div 9</div>
        <div class="box-div">Thẻ Div 10</div>
    </section>

    <!-- BÀI 3: Thay đổi giao diện qua Form -->
    <section>
        <h2>Bài 3: Thay đổi thuộc tính trang web</h2>
        <p>Màu nền: <input type="text" id="MauNen" value="#ffffcc"></p>
        <p>Màu chữ: <input type="text" id="MauChu" value="#000099"></p>
        <p>Tiêu đề: <input type="text" id="TieuDe" value="Trang Web Đã Đổi Tiêu Đề"></p>
        <p>Trạng thái: <input type="text" id="TrangThai" value="Sẵn sàng"></p>
        <button onclick="updateStyles()">Thay đổi</button>
    </section>

    <!-- BÀI 4: Đổi màu nền bằng nút Xanh/Đỏ -->
    <section>
        <h2>Bài 4: Đổi màu nền nhanh</h2>
        <input type="button" value="Xanh" onclick="document.body.style.backgroundColor='lightblue'">
        <input type="button" value="Đỏ" onclick="document.body.style.backgroundColor='lightcoral'">
        <input type="button" value="Mặc định" onclick="document.body.style.backgroundColor='white'">
    </section>

    <!-- BÀI 5: Giải phương trình bậc 2 -->
    <section>
        <h2>Bài 5: Giải phương trình bậc 2 (ax² + bx + c = 0)</h2>
        <input type="text" id="a" size="5" placeholder="a"> x² +
        <input type="text" id="b" size="5" placeholder="b"> x +
        <input type="text" id="c" size="5" placeholder="c"> = 0
        <button onclick="giaiPTBac2()">Giải</button>
        <p id="res5"></p>
    </section>

    <!-- BÀI 6: Slide Show ảnh -->
    <section>
        <h2>Bài 6: Slide Show Hình Ảnh</h2>
        <img id="slideshow" src="https://picsum.photos/id/10/400/200" width="400" height="200" style="display:block; margin-bottom:10px;">
        <button onclick="prevImage()">Trở lại</button>
        <button onclick="nextImage()">Kế tiếp</button>
    </section>

    <!-- BÀI 7: Game lật hình -->
    <section>
        <h2>Bài 7: Game Lật Hình Đơn Giản</h2>
        <p>Click vào ô để làm biến mất và xem hình ẩn bên dưới:</p>
        <div class="game-container">
            <div class="game-box gb1" onclick="this.classList.add('hidden')">1</div>
            <div class="game-box gb2" onclick="this.classList.add('hidden')">2</div>
            <div class="game-box gb3" onclick="this.classList.add('hidden')">3</div>
            <div class="game-box gb4" onclick="this.classList.add('hidden')">4</div>
        </div>
    </section>

    <script>
        // JS Bài 1
        function printNumbers() {
            var n = parseInt(document.getElementById('numInput').value);
            var res = document.getElementById('res1');
            if (isNaN(n) || n <= 0) { res.innerText = "Vui lòng nhập số hợp lệ!"; return; }
            var str = "";
            for (var i = 1; i <= n; i++) str += i + " ";
            res.innerText = str;
        }

        // JS Bài 2
        function changeDivColors() {
            var divs = document.querySelectorAll('.box-div');
            for (var i = 0; i < divs.length; i++) {
                divs[i].style.backgroundColor = ((i + 1) % 2 === 0) ? "red" : "green";
                divs[i].style.color = "white";
            }
        }

        // JS Bài 3
        function updateStyles() {
            document.body.style.backgroundColor = document.getElementById('MauNen').value;
            document.body.style.color = document.getElementById('MauChu').value;
            document.title = document.getElementById('TieuDe').value;
            window.status = document.getElementById('TrangThai').value;
        }

        // JS Bài 5
        function giaiPTBac2() {
            var a = parseFloat(document.getElementById('a').value);
            var b = parseFloat(document.getElementById('b').value);
            var c = parseFloat(document.getElementById('c').value);
            var res = document.getElementById('res5');

            if (isNaN(a) || isNaN(b) || isNaN(c)) { res.innerText = "Nhập đủ các hệ số!"; return; }

            if (a === 0) {
                if (b === 0) res.innerText = (c === 0) ? "Vô số nghiệm." : "Vô nghiệm.";
                else res.innerText = "Nghệ thuật bậc nhất x = " + (-c / b);
            } else {
                var delta = b * b - 4 * a * c;
                if (delta < 0) res.innerText = "Phương trình vô nghiệm.";
                else if (delta === 0) res.innerText = "Nghiệm kép x1 = x2 = " + (-b / (2 * a));
                else {
                    var x1 = (-b + Math.sqrt(delta)) / (2 * a);
                    var x2 = (-b - Math.sqrt(delta)) / (2 * a);
                    res.innerText = "x1 = " + x1 + " ; x2 = " + x2;
                }
            }
        }

        // JS Bài 6
        var images = [
            "https://picsum.photos/id/10/400/200",
            "https://picsum.photos/id/11/400/200",
            "https://picsum.photos/id/12/400/200"
        ];
        var imgIdx = 0;
        function showImg() { document.getElementById('slideshow').src = images[imgIdx]; }
        function nextImage() { imgIdx = (imgIdx + 1) % images.length; showImg(); }
        function prevImage() { imgIdx = (imgIdx - 1 + images.length) % images.length; showImg(); }
        setInterval(nextImage, 3000);
    </script>
</body>
</html>
